# ======================================================================
#  ENVIRONMENT CONFIGURATION -- TEMPLATE
# ======================================================================
#
#  HOW TO USE THIS FILE
#  --------------------
#  This file is a TEMPLATE. It is committed to GitHub and must never contain
#  a real secret. To configure the app, copy it to `.env`:
#
#      Windows (PowerShell):   Copy-Item .env.example .env
#      Mac / Linux:            cp .env.example .env
#
#  Then edit `.env` and fill in your real values.
#
#  `.env` is listed in .gitignore, so your secrets stay on your machine and
#  are never pushed to GitHub. This separation is the whole point: anyone can
#  clone the repo and see WHICH settings exist, without ever seeing YOUR keys.
#
#  Every variable here overrides the matching default in app/core/config.py.
# ======================================================================


# ======================================================================
#  >>>>>>>>>>  THE ONLY KEY YOU ACTUALLY NEED  <<<<<<<<<<
# ======================================================================
#
#  GROQ_API_KEY powers the AI that writes the answers.
#
#  HOW TO GET ONE (free, takes about 60 seconds, NO credit card):
#     1. Go to  https://console.groq.com/keys
#     2. Sign in with Google or GitHub.
#     3. Click "Create API Key", give it any name.
#     4. Copy the key -- it starts with  gsk_
#     5. Paste it on the line below, replacing the placeholder.
#
#  Leave it blank and the app still runs end to end in "demo mode": upload,
#  OCR, chunking, embedding and semantic search all work, and the chat returns
#  the top matching passage directly instead of an AI-written summary.
#
GROQ_API_KEY=

# The model Groq runs for us. openai/gpt-oss-120b is free, fast and good at
# following the "only answer from the provided context" instruction.
GROQ_MODEL=openai/gpt-oss-120b

# "groq" for real answers, "mock" to force demo mode even when a key is present.
LLM_PROVIDER=groq

# 0 = strictly factual and repeatable, 1 = creative. Keep it low for document
# question-answering, where invention is the enemy.
LLM_TEMPERATURE=0.1

# Maximum length of a generated answer, in tokens (~3/4 of a word each).
LLM_MAX_TOKENS=2048

# AGENT MODE -- used only when the chat UI's "Deep research" option is selected (mode="agent").
# The agent chooses its own tools (search, list documents, read a section), so
# one question can cost several model calls instead of one.
# Leave AGENT_MODEL blank to reuse GROQ_MODEL above.
AGENT_MODEL=
# Maximum model calls per agent answer. Stops a confused agent looping forever
# and protects your Groq free-tier rate limit.
AGENT_MAX_STEPS=6


# ======================================================================
#  EMBEDDINGS -- no API key required
# ======================================================================
#
#  "local" runs the model on your own machine: free, offline, private.
#  The model (~90 MB) downloads automatically the first time you upload a
#  document, then is cached on disk.
#
#  Options: local | openai | mock
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# !! Must match the model's real output size, or Postgres rejects every insert.
#      all-MiniLM-L6-v2       -> 384
#      text-embedding-3-small -> 1536
#    Changing this also requires re-processing every document already uploaded.
EMBEDDING_DIMENSION=384

# How many chunks to embed per batch. Lower this if you run out of memory.
EMBEDDING_BATCH_SIZE=32

# OPTIONAL: only needed if you set EMBEDDING_PROVIDER=openai (paid).
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ======================================================================
#  RETRIEVAL -- how semantic search behaves
# ======================================================================
# How many document excerpts to hand the AI as context for each question.
# More context is not always better: irrelevant excerpts actively distract the
# model and make answers worse.
RETRIEVAL_TOP_K=5

# Throw away matches weaker than this (0 = unrelated, 1 = identical meaning).
# This is what lets the app say "I could not find that" instead of inventing an
# answer from the closest-but-still-irrelevant paragraph.
# Raise it toward 0.3 if you get loose matches; lower it if answers say "not
# found" too readily.
RETRIEVAL_MIN_SCORE=0.15


# ======================================================================
#  CHUNKING -- how documents are split up before embedding
# ======================================================================
# fixed_size | sentence | markdown
DEFAULT_CHUNK_STRATEGY=fixed_size

# Size of each chunk in TOKENS, not characters (~500 tokens = 2 paragraphs).
DEFAULT_CHUNK_SIZE=500

# Tokens repeated from the end of the previous chunk, so a sentence spanning a
# boundary is not lost or split so that neither half makes sense.
DEFAULT_CHUNK_OVERLAP=50


# ======================================================================
#  APPLICATION
# ======================================================================
PROJECT_NAME="DocMinds"
ENV=development
DEBUG=True
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# The deployed frontend URL, so the browser is allowed to call this API.
# Comma-separated for several. localhost:3000 is already permitted by default.
# Example: FRONTEND_ORIGIN=https://your-app.vercel.app
FRONTEND_ORIGIN=


# ======================================================================
#  POSTGRESQL
# ======================================================================
# Port 5433 (not 5432) because docker-compose maps the container's 5432 to 5433
# on your machine, avoiding a clash with any locally installed Postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=document_intelligence

# For cloud hosting (Render, Neon, Railway): one full connection string that
# overrides all five settings above. Leave blank when running locally.
DATABASE_URL=


# ======================================================================
#  REDIS  (the queue Celery uses for background document processing)
# ======================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# For cloud hosting: a complete redis:// URL that overrides the two above.
REDIS_URL_OVERRIDE=


# ======================================================================
#  SECURITY
# ======================================================================
# !! GENERATE A NEW ONE BEFORE DEPLOYING ANYWHERE PUBLIC:
#        openssl rand -hex 32
#    Anyone who knows this key can forge a login token for any user.
SECRET_KEY=7e15291b0f19c25f1b1c55bc6d01e1498b671a532321bc36efc0d8f07df590ad
ALGORITHM=HS256
#    With ENV=production the API refuses to start while this is still the
#    default above, or is shorter than 32 characters.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# ======================================================================
#  ACCOUNTS AND EMAIL  (invites, password reset, email verification)
# ======================================================================
PASSWORD_MIN_LENGTH=10
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48
INVITE_EXPIRE_DAYS=7
# true = an account must confirm its email before it can sign in.
REQUIRE_EMAIL_VERIFICATION=false

# Where links in emails point (the frontend). Empty = first FRONTEND_ORIGIN,
# else http://localhost:3000.
FRONTEND_URL=

# Leave SMTP_HOST empty to have emails written to the API log instead of sent
# (copy the link from the terminal). Set it to deliver real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=DocMinds <no-reply@docminds.local>


# ======================================================================
#  OCR  (reading scanned PDFs and images)
# ======================================================================
# Requires the Tesseract PROGRAM to be installed as well -- it is not a Python
# package. See docs/DEVELOPMENT.md (Prerequisites) for installation instructions.
OCR_PROVIDER=tesseract

# On Mac/Linux the default below is fine. On Windows use the full path, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract

# A PDF page yielding fewer characters than this is treated as a scan and sent
# to OCR. Normal text pages hold 1500-3000 characters; scans extract near zero.
OCR_CHAR_THRESHOLD_PER_PAGE=100

# Resolution for converting PDF pages to images before OCR. Higher is more
# accurate but slower and more memory-hungry.
OCR_DPI=150


# ======================================================================
#  UPLOAD LIMITS AND ZIP SAFETY
# ======================================================================
# Per file, counted while reading (413 when exceeded), and how many files one
# request may carry. Together they cap the whole request body.
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_FILES_PER_UPLOAD=20

# Zip-bomb protection for uploaded .zip archives.
ZIP_MAX_ENTRIES=1000
ZIP_MAX_TOTAL_UNCOMPRESSED_BYTES=524288000
ZIP_MAX_COMPRESSION_RATIO=100
ZIP_MAX_NESTING_DEPTH=1


# ======================================================================
#  FILE STORAGE  (where the original uploaded files are kept)
# ======================================================================
# local -> backend/uploads (or LOCAL_STORAGE_DIR). Fine for development; a
#          cloud container's disk is usually wiped on every restart.
# s3    -> any S3-compatible bucket: AWS S3, Cloudflare R2, MinIO, B2.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=

# Only read when STORAGE_BACKEND=s3. Leave the keys empty to use boto3's normal
# credential chain (an IAM role, AWS_* variables, ~/.aws).
#   Cloudflare R2: S3_REGION=auto, S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
#   MinIO:         S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=


# ======================================================================
#  INGESTION DURABILITY  (retries, time limits, recovering stuck jobs)
# ======================================================================
INGESTION_MAX_RETRIES=3
# First retry waits this long; each later one doubles it (10s, 20s, 40s).
INGESTION_RETRY_BACKOFF_SECONDS=10
INGESTION_RETRY_BACKOFF_MAX_SECONDS=600
INGESTION_SOFT_TIME_LIMIT_SECONDS=1500
INGESTION_TIME_LIMIT_SECONDS=1800
# Must be longer than INGESTION_TIME_LIMIT_SECONDS.
INGESTION_STALE_AFTER_MINUTES=45
INGESTION_RECOVERY_INTERVAL_MINUTES=10
INGESTION_RECOVER_ON_STARTUP=true


# ======================================================================
#  MALWARE SCANNING  (optional)
# ======================================================================
# off    -> no scanning (default)
# clamav -> stream every upload to a ClamAV daemon before processing it.
#           `docker compose --profile scan up -d` starts one locally.
MALWARE_SCAN=off
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# A Unix socket path; when set it wins over host/port.
CLAMAV_SOCKET=
CLAMAV_TIMEOUT_SECONDS=60


# ======================================================================
#  LANGUAGE MODEL ROBUSTNESS
# ======================================================================
# Transient errors (429, 5xx, dropped connections) are retried with
# exponential backoff (1s, 2s, ...). Bad keys and bad requests are not.
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0
LLM_TIMEOUT_SECONDS=30
# A second Groq model tried when the main one keeps failing or is retired.
LLM_FALLBACK_MODEL=


# ======================================================================
#  RATE LIMITING  ("<count>/<period>", or "off")
# ======================================================================
RATE_LIMIT_ENABLED=true
# auto -> Redis when reachable, in-memory otherwise; memory -> always in-memory
RATE_LIMIT_STORAGE=auto
RATE_LIMIT_LOGIN=20/minute
RATE_LIMIT_SIGNUP=10/hour
RATE_LIMIT_PASSWORD_RESET=10/hour
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_UPLOAD=30/minute
# Public share-link views, per IP; document comparisons, per user.
RATE_LIMIT_SHARE_VIEW=120/minute
RATE_LIMIT_COMPARE=10/minute
# Behind a proxy (Render, nginx, a load balancer) set how many proxies YOU
# control, so the real client IP is read from X-Forwarded-For. 0 = no proxy.
TRUSTED_PROXY_COUNT=0
# Or a header your CDN overwrites with the client IP, e.g. CF-Connecting-IP.
CLIENT_IP_HEADER=


# ======================================================================
#  QUOTAS AND METERING  (per organization; 0 = unlimited)
# ======================================================================
QUOTA_MONTHLY_TOKENS=1000000
QUOTA_MAX_DOCUMENTS=1000
QUOTA_MAX_STORAGE_BYTES=5368709120
# USD per million tokens, for the cost estimate at GET /api/v1/org/usage.
# LLM_PRICING={"openai/gpt-oss-120b": {"input": 0.15, "output": 0.60}}


# ======================================================================
#  OBSERVABILITY
# ======================================================================
# json -> one JSON object per log line (for log platforms); text -> readable
LOG_FORMAT=json
LOG_LEVEL=INFO
# Optional Sentry error reporting. Empty = off.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=
# /api/v1/health/ready waits at most this long per dependency.
READINESS_TIMEOUT_SECONDS=3
# Strict-Transport-Security max-age; sent only when ENV=production.
HSTS_MAX_AGE_SECONDS=31536000


# ======================================================================
#  SINGLE SIGN-ON (OpenID Connect) -- optional, off by default
# ======================================================================
# Any OIDC provider; the DISCOVERY URL picks which one:
#   Google     https://accounts.google.com/.well-known/openid-configuration
#   Microsoft  https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
#   Okta       https://<your-org>.okta.com/.well-known/openid-configuration
# Register http://localhost:8000/api/v1/auth/sso/callback as the redirect URI.
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_PROVIDER_NAME=SSO
# Empty = <this API>/api/v1/auth/sso/callback, derived from the request.
OIDC_REDIRECT_URI=
# May a first-time SSO user with no invite create their own organization?
OIDC_ALLOW_SIGNUP=true
# Microsoft Entra ID sends no email_verified claim: set false for Entra only.
OIDC_REQUIRE_EMAIL_VERIFIED=true


# ======================================================================
#  MULTILINGUAL EMBEDDINGS -- optional, off by default
# ======================================================================
# true -> the local provider uses MULTILINGUAL_EMBEDDING_MODEL (50+
# languages, still 384 dimensions). Switching REQUIRES RE-INDEXING every
# document: see docs/DEVELOPMENT.md, "Multilingual embeddings".
EMBEDDING_MULTILINGUAL=false
MULTILINGUAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2


# ======================================================================
#  QUERY-EMBEDDING CACHE -- optional, off by default
# ======================================================================
# Caches each QUESTION's vector. auto -> Redis when reachable, else memory.
EMBEDDING_CACHE_ENABLED=false
EMBEDDING_CACHE_BACKEND=auto
EMBEDDING_CACHE_MAX_ENTRIES=2048
EMBEDDING_CACHE_TTL_SECONDS=86400


# ======================================================================
#  WEBHOOKS -- optional, off by default
# ======================================================================
# Admins register URLs at /api/v1/webhooks. Deliveries are signed with
# HMAC-SHA256 and retried with backoff by the Celery worker (or in-process
# with INGESTION_MODE=inline).
WEBHOOKS_ENABLED=false
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_RETRY_BACKOFF_SECONDS=30
WEBHOOK_TIMEOUT_SECONDS=10
# Local testing ONLY (a receiver on localhost). Never in production: these
# switch off the SSRF protection and the HTTPS requirement.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_MAX_ENDPOINTS_PER_ORG=10
