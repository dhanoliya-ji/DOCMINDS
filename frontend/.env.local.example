# The backend API address.
# Local development: the FastAPI server started with uvicorn.
# Production: your deployed Render URL, e.g. https://docminds-api.onrender.com
#
# NEXT_PUBLIC_ prefix means this value is sent to the BROWSER. Never put a
# secret here - anything with this prefix ends up in public JavaScript.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Optional: product analytics with PostHog ----
# Empty (the default) = no analytics at all: no banner, no script, nothing
# sent. With a key, visitors are asked first, and only anonymous page views
# are sent -- see lib/analytics.ts. PostHog project keys are public by
# design (they can only SEND events), so NEXT_PUBLIC_ is fine here.
NEXT_PUBLIC_POSTHOG_KEY=
# EU cloud: https://eu.i.posthog.com ; self-hosted: your instance's URL.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
